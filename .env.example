# Copy this file to .env and fill in real values. Never commit .env.

# mysql (local XAMPP), pgsql (Supabase Postgres) or sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=subtrack
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Supabase (when DB_DRIVER=pgsql) ---
# Use the pooler connection string from Supabase > Project Settings > Database
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASS=your-database-password
# DB_SSLMODE=require

APP_ENV=local
APP_DEBUG=true
